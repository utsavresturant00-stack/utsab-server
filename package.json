{
  "name": "utsav-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "REST API for the UTSAV website, admin panel and waiter panel (MongoDB).",
  "main": "server.cjs",
  "scripts": {
    "build": "node -e \"console.log('No build step: the API runs as is.')\"",
    "seed:build": "node -e \"console.log('No build step: the API runs as is.')\"",
    "start": "node server.cjs",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.mjs",
    "seed:users": "node scripts/seed-users.mjs",
    "seed:tables": "node scripts/seed-tables.mjs",
    "demo": "node scripts/demo-orders.mjs",
    "seed:from-client": "node scripts/build-seed.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "multer": "^2.0.2"
  }
}
