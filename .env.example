PORT=4000

# MongoDB connection string. The database name goes after the host, e.g. .../utsav
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/utsav?retryWrites=true&w=majority

# A long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If empty, one is generated once and stored in the database.
JWT_SECRET=
TOKEN_TTL=7d

# Websites allowed to call the API, comma separated. Empty allows any (fine locally).
CORS_ORIGINS=

TZ_NAME=Asia/Kolkata
